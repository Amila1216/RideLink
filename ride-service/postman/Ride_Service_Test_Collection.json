    {
      "name": "01 - Create Ride (Positive - HTTP 201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Response contains valid ride details with status REQUESTED', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.not.be.empty;",
              "    pm.expect(jsonData.passengerId).to.eql('pass-101');",
              "    pm.expect(jsonData.pickupLocation).to.eql('123 Main St');",
              "    pm.expect(jsonData.dropoffLocation).to.eql('456 Market St');",
              "    pm.expect(jsonData.status).to.eql('REQUESTED');",
              "    ",
              "    // Store rideId for dynamic chained requests",
              "    pm.collectionVariables.set('rideId', jsonData.id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"passengerId\": \"pass-101\",\n  \"pickupLocation\": \"123 Main St\",\n  \"dropoffLocation\": \"456 Market St\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/rides",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "rides"
          ]
        },
        "description": "Positive Test: Create a new ride request. Asserts HTTP 201 status and initial status set to REQUESTED."
      }
    },
